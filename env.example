# Choose one: openai or openrouter
LLM_PROVIDER=openrouter

# Optional shared override for either provider
# MODEL_ID=

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# OpenRouter settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=hackathon-scout

# --- HTTP API (all optional; the API degrades gracefully when missing) ---

# If set, all /v1/* routes require: Authorization: Bearer <API_TOKEN>
API_TOKEN=

# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*

# Hard request deadline (ms) for the scout pipeline
REQUEST_TIMEOUT_MS=90000

# Optional Upstash-backed cache + rate-limit (no-op if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MIN=10

# Logger verbosity: debug | info | warn | error
LOG_LEVEL=info
