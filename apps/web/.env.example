# URL of the @scout/api deployment (or local dev server).
# Leave empty to call same-origin (works when api + web share a domain).
# Local dev with the Hono node-server: NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=

# Optional bearer token if SCOUT_API_TOKEN is set on the API.
NEXT_PUBLIC_API_TOKEN=
